# Copy to .env and adjust. Never commit .env. Empty values are treated as unset.

# development | production. Production requires API_TOKEN and explicit CORS_ALLOWED_ORIGINS (no '*').
APP_ENV=development
# Bind address and port (1-65535).
API_HOST=127.0.0.1
API_PORT=8000
# Bearer token clients must send. Required in production. Never logged.
API_TOKEN=
# Comma-separated allowed origins, e.g. https://app.example.com,https://other.example.com
CORS_ALLOWED_ORIGINS=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# Where run results are stored.
OUTPUT_DIRECTORY=./output
# Runs older than this many days are deleted (latest run per notebook is kept). Must be > 0.
RETENTION_DAYS=7
# Maximum notebook execution time in seconds. Must be > 0.
NOTEBOOK_TIMEOUT_SECONDS=1800
# Concurrent notebook jobs (>= 1). One active run per notebook.
MAX_CONCURRENT_RUNS=2

# ollama | lmstudio
AI_PROVIDER=ollama
# Seconds without a new token before a model request is given up (TIMEOUT for that analysis). Must be > 0.
AI_STALL_TIMEOUT_SECONDS=600
# Total limit of one model request in seconds, however many tokens arrive. Must be > 0.
AI_TOTAL_TIMEOUT_SECONDS=14400
# Maximum output tokens of a model answer, sent on every request. Must be >= 1.
AI_MAX_OUTPUT_TOKENS=32768
# Deprecated: AI_TIMEOUT_SECONDS sets the total limit when AI_TOTAL_TIMEOUT_SECONDS is not set.
AI_TIMEOUT_SECONDS=
OLLAMA_BASE_URL=http://localhost:11434
# Model used by market analysis (only checked when it is used).
OLLAMA_MODEL=
LM_STUDIO_BASE_URL=http://localhost:1234
# Model identifier used by market analysis (only checked when it is used).
LM_STUDIO_MODEL=
# Comma-separated provider:model pairs compared by the benchmark, e.g. ollama:llama3:8b,lmstudio:my-model
BENCHMARK_MODELS=

# api | csv
DATA_SOURCE=api
# Market data API base URL. Required when DATA_SOURCE=api.
MARKET_DATA_API_URL=
# Token for the market data API. Never logged.
MARKET_DATA_API_TOKEN=
# Folder with example CSV files (DATA_SOURCE=csv).
MARKET_DATA_CSV_PATH=./data/example
