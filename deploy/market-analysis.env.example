# Settings for the market analysis service. Copy to market-analysis.env (git-ignored).
# Values are plain text: do not quote them. Make the key with: openssl rand -hex 32

# production requires API_TOKEN and explicit CORS_ALLOWED_ORIGINS.
APP_ENV=production
# The key callers must send in X-API-Key. The NFHotel web application holds the same value as
# HolidayApi__ApiKey in its own env file.
API_TOKEN=change-me
# The web application calls the service from the server, not from a browser; this origin only
# satisfies the production rule and allows nothing else.
CORS_ALLOWED_ORIGINS=https://localhost
# The service serves the holiday calendar and the market analysis run API (the bookings come in the
# request body); it reads no market data of its own, so csv is enough.
DATA_SOURCE=csv
LOG_FORMAT=json

# AI insights. Leave the model name empty to switch them off (every insight is then AI_NOT_CONFIGURED).
# ollama | lmstudio
AI_PROVIDER=ollama
# From the container the host is reachable as host.docker.internal (use the address of your model server).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
LM_STUDIO_BASE_URL=http://host.docker.internal:1234
LM_STUDIO_MODEL=
# Seconds without a new token before a model request is given up (TIMEOUT for that analysis).
AI_STALL_TIMEOUT_SECONDS=600
# Total limit of one model request in seconds, however many tokens arrive (4 hours).
AI_TOTAL_TIMEOUT_SECONDS=14400
# Maximum output tokens of a model answer; a reasoning model needs room to think and still answer.
AI_MAX_OUTPUT_TOKENS=32768

# Name of the Docker network that NFHotel makes. Compose reads it from this file.
NFHOTEL_API_NETWORK=nfhotel-api
