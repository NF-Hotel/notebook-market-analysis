# Settings for the market analysis service. Copy to market-analysis.env (git-ignored).
# Values are plain text: do not quote them. Make the key with: openssl rand -hex 32

# production requires API_TOKEN and explicit CORS_ALLOWED_ORIGINS.
APP_ENV=production
# The key callers must send in X-API-Key. The NFHotel web application holds the same value as
# HolidayApi__ApiKey in its own env file.
API_TOKEN=change-me
# The web application calls the service from the server, not from a browser; this origin only
# satisfies the production rule and allows nothing else.
CORS_ALLOWED_ORIGINS=https://localhost
# The service serves holidays only for now; it reads no market data.
DATA_SOURCE=csv
LOG_FORMAT=json

# Name of the Docker network that NFHotel makes. Compose reads it from this file.
NFHOTEL_API_NETWORK=nfhotel-api
